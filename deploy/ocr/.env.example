# คัดลอกเป็น .env แล้วแก้ค่า (อย่า commit ไฟล์ .env)
# เวอร์ชัน thaidoc = hash ของ commit ที่ clone มา (git rev-parse --short HEAD) ใช้เป็น tag ของ image
THAIDOC_VERSION=37b9975
# ที่อยู่ของซอร์ส thaidoc เทียบกับโฟลเดอร์ deploy/ocr (บน VM: ~/docflow/thaidoc-src)
THAIDOC_SRC=../../../thaidoc-src
# Dockerfile สำหรับ CPU (บนเครื่อง GPU ใช้ Dockerfile.gpu)
THAIDOC_DOCKERFILE=Dockerfile
# จำนวนเธรด CPU ที่ thaidoc ใช้
THAIDOC_CPU_THREADS=4
# คีย์ที่ DocFlow ใช้ส่งใน Authorization: Bearer (สร้างด้วย openssl rand -hex 32)
OCR_API_KEY=replace-with-openssl-rand-hex-32
# พอร์ตภายในของ proxy (:8000 = HTTP ธรรมดา; บนเครื่อง GPU ใส่โดเมนเพื่อให้ Caddy ทำ HTTPS เอง)
OCR_SITE_ADDRESS=:8000
# พอร์ตที่เปิดบนโฮสต์ (127.0.0.1 = เข้าได้จากในเครื่องเท่านั้น)
OCR_PROXY_PUBLISH=127.0.0.1:18000
