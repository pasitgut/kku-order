NEXT_PUBLIC_API_URL=/backend
BACKEND_INTERNAL_URL=http://localhost:8080
MYSQL_HOST_PORT=3307
DB_DSN=docflow:docflow@tcp(localhost:3307)/docflow?charset=utf8mb4&parseTime=True&loc=Local
AUTH_REQUIRED=false
AUTH_USER_HEADER=X-Auth-Request-User
AUTH_ROLE_HEADER=X-Auth-Request-Role
IMPORT_DIR=./incoming
IMPORT_CRON=*/5 * * * *
GOOGLE_DRIVE_FOLDER_ID=1HAQQhmzVq9Ch0_UZKWSnhrJmY-5t1SUr
GOOGLE_DRIVE_CREDENTIALS_FILE=/run/secrets/google-drive-service-account.json
GOOGLE_DRIVE_SYNC_CRON=*/5 * * * *
EXTERNAL_USERS_URL=https://fs.computing.kku.ac.th/api/ext/v1/users
API_KEY=replace-with-university-api-key
USER_SYNC_CRON=0 5 * * *
USER_SYNC_TZ=Asia/Bangkok
EXPIRY_CRON=10 5 * * *
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OCR_LANGUAGE=thai
OCR_DPI=200
OCR_MAX_SIDE=1536
OCR_PREPROCESS=none
# การเชื่อม thaidoc-extract (OCR API) ผ่าน reverse proxy
# URL ของ proxy ใน network docflow-ocr และคีย์ ต้องเป็นค่าเดียวกับ OCR_API_KEY ใน deploy/ocr/.env
OCR_API_URL=http://ocr-proxy:8000
OCR_API_KEY=replace-with-ocr-api-key
# ทางเลือก: อ่านคีย์จากไฟล์แทนการใส่ค่าในตัวแปร (ปล่อยว่างถ้าไม่ใช้)
OCR_API_KEY_FILE=
# เวลารอสูงสุดต่อเอกสาร 1 ฉบับ รูปแบบ Go duration เช่น 10m
OCR_API_TIMEOUT=10m
# จำนวนเอกสารที่ส่งไป OCR พร้อมกัน
OCR_API_CONCURRENCY=1
